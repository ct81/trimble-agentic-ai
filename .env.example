# Copy to .env.local (never commit it)
# UUID of the agent you published in Agent Studio
VITE_AGENT_ID=<your-agent-uuid>
# DEV ONLY: a Trimble Identity access token for local testing.
# VITE_ variables are bundled into the browser, so never use this in production.
VITE_DEV_ACCESS_TOKEN=<your-trimble-identity-access-token>
